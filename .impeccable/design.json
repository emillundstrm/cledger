      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-nav{display:flex;gap:4px}.ds-tab{font-family:Geist,ui-sans-serif,system-ui,sans-serif;padding:6px 14px;border-radius:10px;font-size:14px;font-weight:500;color:var(--muted);text-decoration:none;transition:color .2s,background .3s cubic-bezier(.2,.8,.2,1),transform .2s}.ds-tab:hover{color:var(--ink)}.ds-tab:active{transform:scale(.95)}.ds-tab-active{background:var(--wash);color:var(--ink)}.ds-tab:focus-visible{outline:2px solid oklch(0.72 0.17 40 / .5);outline-offset:2px}"
    },
    {
