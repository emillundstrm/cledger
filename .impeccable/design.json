      "refersTo": "type-pill",
      "description": "Selected is a tint: type hue for types, Wash for neutral filters. Never solid.",
      "html": "<button class=\"ds-chip\">Board</button> <button class=\"ds-chip ds-chip-on\">Boulder</button> <button class=\"ds-chip ds-chip-neutral\">handla</button>",
      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-chip{font-family:Geist,ui-sans-serif,system-ui,sans-serif;--c:var(--board);padding:8px 16px;border:1px solid var(--rule);border-radius:999px;background:transparent;color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;transition:transform .18s cubic-bezier(.2,.7,.3,1.3),color .18s,background .18s,border-color .18s}.ds-chip:hover{border-color:var(--c)}.ds-chip:active{transform:scale(.95)}.ds-chip-on{--c:var(--boulder);color:var(--c);border-color:var(--c);background:color-mix(in oklab,var(--c) 15%,transparent)}.ds-chip-neutral{color:var(--ink);border-color:var(--muted);background:var(--wash)}.ds-chip:focus-visible{outline:2px solid oklch(0.72 0.17 40 / .5);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-item-selected",
      "description": "One control for every 2–4-way choice: pill track, selected item on Wash.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-i ds-seg-on\" role=\"radio\" aria-checked=\"true\">Pass</button><button class=\"ds-seg-i\" role=\"radio\" aria-checked=\"false\">Minuter</button></div>",
      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-seg{font-family:Geist,ui-sans-serif,system-ui,sans-serif;display:inline-flex;gap:2px;padding:3px;border:1px solid var(--rule);border-radius:999px}.ds-seg-i{padding:6px 16px;border:none;border-radius:999px;background:transparent;color:var(--muted);font-size:13px;font-weight:500;cursor:pointer;transition:color .2s,background .3s cubic-bezier(.2,.8,.2,1)}.ds-seg-i:hover{color:var(--ink)}.ds-seg-on{background:var(--wash);color:var(--ink)}.ds-seg-i:focus-visible{outline:2px solid oklch(0.72 0.17 40 / .5);outline-offset:2px}"
    },
    {
      "name": "Container",
      "kind": "card",
      "refersTo": "container",
      "description": "Standalone group: hairline box, no fill, no shadow, 14px.",
      "html": "<section class=\"ds-box\"><p class=\"ds-box-label\">Belastning (denna vecka)</p><p class=\"ds-box-num\">510</p></section>",
      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-box{font-family:Geist,ui-sans-serif,system-ui,sans-serif;width:240px;padding:20px;border:1px solid var(--rule);border-radius:14px;color:var(--ink)}.ds-box-label{margin:0;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.ds-box-num{margin:8px 0 0;font-family:'DM Serif Text',Georgia,serif;font-size:36px;line-height:1}"
