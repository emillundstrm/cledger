      "description": "Selectable session-type chip; selected takes the type hue.",
      "html": "<button class=\"ds-chip\">Board</button> <button class=\"ds-chip ds-chip-on\">Boulder</button>",
      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-chip{font-family:Geist,ui-sans-serif,system-ui,sans-serif;--c:var(--board);padding:8px 16px;border:1px solid var(--rule);border-radius:999px;background:var(--card);color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;transition:transform .18s cubic-bezier(.2,.7,.3,1.3),color .18s,background .18s,border-color .18s}.ds-chip:hover{transform:translateY(-1px);border-color:var(--c)}.ds-chip:active{transform:scale(.95)}.ds-chip-on{--c:var(--boulder);color:var(--c);border-color:var(--c);background:color-mix(in oklab,var(--c) 16%,transparent)}.ds-chip:focus-visible{outline:2px solid oklch(0.72 0.17 40 / .5);outline-offset:2px}"
