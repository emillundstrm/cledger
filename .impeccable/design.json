      "css": ":host{--bg:oklch(0.16 0.018 255);--card:oklch(0.20 0.022 255);--card2:oklch(0.235 0.026 255);--wash:oklch(0.27 0.03 255);--rule:oklch(0.305 0.03 255);--ink:oklch(0.95 0.008 255);--muted:oklch(0.73 0.02 255);--dim:oklch(0.55 0.025 255);--ember:oklch(0.72 0.17 40);--glow:oklch(0.72 0.17 40 / 0.25);--shadow:oklch(0 0 0 / 0.45);--boulder:oklch(0.78 0.14 55);--board:oklch(0.75 0.12 245);--routes:oklch(0.78 0.13 165)} .ds-card{font-family:Geist,ui-sans-serif,system-ui,sans-serif;display:block;width:420px;padding:16px 28px 16px 25px;border:1px solid var(--rule);border-left:3px solid var(--ember);border-radius:14px;background:var(--card);color:var(--ink);text-decoration:none;transition:transform .18s cubic-bezier(.2,.7,.3,1),box-shadow .18s,background-color .18s}.ds-card:hover{transform:translate(2px,-2px);box-shadow:0 10px 28px var(--shadow);background:var(--card2)}.ds-card:focus-visible{outline:2px solid oklch(0.72 0.17 40 / .5);outline-offset:2px}.ds-card-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ds-card-title{font-weight:500;font-size:15px}.ds-card-badge{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.ds-card-time{margin-left:auto;font-size:12px;color:var(--dim)}.ds-card-preview{margin:8px 0 0;font-size:14px;color:var(--muted)}"
    }
